{
  "name": "NetworkingGoal",
  "type": "object",
  "properties": {
    "goal_type": {
      "type": "string",
      "enum": [
        "find_investors",
        "find_photographers",
        "get_clients",
        "meet_entrepreneurs",
        "find_cofounder",
        "expand_network",
        "find_creators",
        "find_podcast_hosts",
        "hire_talent",
        "custom"
      ],
      "default": "expand_network"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_count": {
      "type": "number",
      "default": 10
    },
    "current_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "deadline": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "goal_type",
    "title"
  ]
}