{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "harassment",
        "stalking",
        "underage_suspicion",
        "threat",
        "spam",
        "inappropriate",
        "fake_profile",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "is_high_severity": {
      "type": "boolean",
      "default": false
    },
    "requires_manual_review": {
      "type": "boolean",
      "default": false
    },
    "conversation_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "reporter_id",
    "reported_user_id",
    "reason"
  ]
}