{
  "name": "NetworkingMemory",
  "type": "object",
  "properties": {
    "target_user_id": {
      "type": "string"
    },
    "target_username": {
      "type": "string"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "met",
        "messaged",
        "connected",
        "followed_up",
        "viewed_profile"
      ],
      "default": "connected"
    },
    "summary": {
      "type": "string"
    },
    "key_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_interaction_date": {
      "type": "string",
      "format": "date-time"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "follow_up_reason": {
      "type": "string"
    },
    "compatibility_score": {
      "type": "number"
    }
  },
  "required": [
    "target_user_id",
    "interaction_type"
  ]
}