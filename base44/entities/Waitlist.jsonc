{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "is_international": {
      "type": "boolean",
      "default": false
    },
    "international_location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waitlisted",
        "active",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "waitlisted"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}