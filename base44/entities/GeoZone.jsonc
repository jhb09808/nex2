{
  "name": "GeoZone",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "radius_miles": {
      "type": "number",
      "default": 0.25
    },
    "is_restricted": {
      "type": "boolean",
      "default": false
    },
    "restriction_reason": {
      "type": "string"
    },
    "created_by_admin_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}