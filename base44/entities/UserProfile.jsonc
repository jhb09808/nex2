{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string",
      "format": "uri"
    },
    "show_profile_photo": {
      "type": "boolean",
      "default": false
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary",
        "prefer_not_to_say"
      ]
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "anonymous",
        "first_name",
        "full_profile"
      ],
      "default": "full_profile"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "proximity_tier": {
      "type": "string",
      "enum": [
        "same_venue",
        "same_block",
        "nearby",
        "far"
      ],
      "default": "nearby"
    },
    "location_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "is_adult": {
      "type": "boolean",
      "default": false
    },
    "adult_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "none",
        "self_attested",
        "id_verified"
      ],
      "default": "none"
    },
    "requires_reverification": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "plus",
        "pro",
        "platinum"
      ],
      "default": "free"
    },
    "radius_miles": {
      "type": "number",
      "default": 1
    },
    "daily_chat_count": {
      "type": "number",
      "default": 0
    },
    "last_chat_reset_date": {
      "type": "string",
      "format": "date"
    },
    "invisible_mode": {
      "type": "boolean",
      "default": false
    },
    "platinum_only_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "profile_boost_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_verified_photo_badge": {
      "type": "boolean",
      "default": false
    },
    "subscription_renewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_suspended": {
      "type": "boolean",
      "default": false
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "blocked_users": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notification_settings": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "boolean",
          "default": true
        },
        "nearby": {
          "type": "boolean",
          "default": true
        },
        "events": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": [
    "username"
  ]
}