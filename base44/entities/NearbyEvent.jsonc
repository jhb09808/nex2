{
  "name": "NearbyEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "host_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}